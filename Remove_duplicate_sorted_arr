class Solution:
    def removeDuplicates(self, nums: List[int]) -> int:
        if not nums:   #edge case if arr empty
            return None

        left = 1 # Left pointer pehle index par wait karega

        for right in range(1, len(nums)): #Loop aakhri element se ek pehle hi ruk jayega (len(nums) - 1)
            if nums[right] != nums[right - 1]: #LOGIC: check kra ki agla number alag hai ya nahi
                nums[left] = nums[right]   # Agla unique number left position par copy kr
                left += 1

        return left       

# at first my logic was to check/compare wit the next no not the previous one but if want to compare previous so right -1 kra and len(nums) means last tk jana loop me

