class Solution:
    def eraseOverlapIntervals(self, intervals: List[List[int]]) -> int:
        intervals.sort(key=lambda x: x[1]) #end time ke basis pr sort so phle khatam hone wale phle aaye

        count = 0
        prev_end = intervals[0][1] #phle interval ka end time save

        for i in range(1, len(intervals)):
            current_start = intervals[i][0]
            current_end = intervals[i][1]

            if current_start < prev_end: #agr naya inter purane ke khatam hone se phle shuru(overlap)
                count += 1  #remove this interval
            else:
                prev_end = current_end  #koi overlap nhi end time update 

        return count 
        
